rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && request.auth.uid == 'CWo2ULEH4oZviK7VXgrFP9e45Sz1' && request.auth.token.email_verified == true; }
    function text(v,n) { return v is string && v.size() <= n && !v.matches('.*[<>"\'`\\\\&].*'); }
    function validRequest(r) {
      return r.keys().hasOnly(['id','category','name','specialty','center','governorate','phone','discount','address','schedule','mapUrl','notes','status','createdAt'])
        && r.keys().hasAll(['id','category','name','specialty','center','governorate','phone','discount','address','schedule','mapUrl','notes','status','createdAt'])
        && r.category in ['doctor','pharmacy','lab','radiology','hospital','center']
        && text(r.id,60) && r.name.size()>1 && text(r.name,150)
        && text(r.specialty,250) && text(r.center,100) && text(r.governorate,100)
        && text(r.phone,25) && r.phone.matches('[+0-9 ()-]{8,25}')
        && text(r.discount,30) && text(r.address,350) && text(r.schedule,250)
        && text(r.notes,1000) && text(r.mapUrl,500)
        && (r.mapUrl == '' || r.mapUrl.matches('https://.*'))
        && r.status == 'pending' && r.createdAt == request.time;
    }
    match /providers/{id} {
      allow get,list: if resource.data.approved == true || owner();
      allow create,update,delete: if owner();
    }
    match /providerContacts/{id} { allow read,write: if owner(); }
    match /subscribers/{id} {
      allow read,update,delete: if owner();
      allow create: if owner() || (request.resource.data.keys().hasOnly(['id','name','phone','governorate','address','familyMembers','consent','status','createdAt'])
        && request.resource.data.id == id && text(request.resource.data.id,60)
        && text(request.resource.data.name,150) && request.resource.data.name.size()>1
        && text(request.resource.data.phone,25) && request.resource.data.phone.matches('[+0-9 ()-]{8,25}')
        && text(request.resource.data.governorate,100) && text(request.resource.data.address,350)
        && request.resource.data.familyMembers is list && request.resource.data.familyMembers.size() <= 5
        && (request.resource.data.familyMembers.size() < 1 || text(request.resource.data.familyMembers[0],150))
        && (request.resource.data.familyMembers.size() < 2 || text(request.resource.data.familyMembers[1],150))
        && (request.resource.data.familyMembers.size() < 3 || text(request.resource.data.familyMembers[2],150))
        && (request.resource.data.familyMembers.size() < 4 || text(request.resource.data.familyMembers[3],150))
        && (request.resource.data.familyMembers.size() < 5 || text(request.resource.data.familyMembers[4],150))
        && request.resource.data.consent == true && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time);
    }
    match /memberLookup/{token} {
      allow get: if token.size() == 64 || owner();
      allow list: if owner();
      allow create,update,delete: if owner();
    }
    match /members/{id} { allow read,write: if owner(); }
    match /requests/{id} {
      allow read,update,delete: if owner();
      allow create: if owner() || (validRequest(request.resource.data) && request.resource.data.id == id);
    }
    match /appContent/interface {
      allow get: if true;
      allow list: if false;
      allow create,update: if owner()
        && request.resource.data.keys().hasOnly(['version','texts','updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.texts is string
        && request.resource.data.texts.size() <= 400000
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner();
    }
    match /{document=**} { allow read,write: if false; }
  }
}
